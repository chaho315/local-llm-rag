# ===== 로컬 LLM RAG 챗봇 환경설정 예시 =====
# 실제 값으로 채운 뒤 이 파일을 rag 실행 경로에 ".env" 로 저장하세요.
# (.env 는 .gitignore 에 의해 git 에 커밋되지 않습니다 — 절대 커밋하지 마세요.)

# --- MySQL 접속 (읽기 전용 계정) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=llmuser
MYSQL_PASSWORD=CHANGE_ME_PASSWORD
MYSQL_DATABASE=OLLAMA_LLM

# --- Oracle (선택; 미사용 시 config.yaml 의 sources.oracle.enabled=false) ---
ORACLE_USER=readonly_user
ORACLE_PASSWORD=CHANGE_ME_PASSWORD
ORACLE_DSN=host:1521/SERVICE

# --- 뉴스 RSS 수집 (NEWS_RSS 쓰기 계정) ---
RSS_MAX=1000
RSS_PER_FEED=50
RSS_DELAY=0.4
RSS_INDEX_MAX=300          # 시간당 실행 시 색인 상한(0=전체). 야간 백필은 0으로 전량.
NEWS_WRITER_USER=newswriter
NEWS_WRITER_PASSWORD=CHANGE_ME_PASSWORD

# --- 공공데이터포털 주식시세정보 API (https://www.data.go.kr) ---
STOCK_API_KEY=YOUR_STOCK_API_KEY
STOCK_MAX_INDEX=500
STOCK_LOOKBACK=10

# --- DART 전자공시 OpenAPI (https://opendart.fss.or.kr) ---
DART_API_KEY=YOUR_DART_API_KEY
DART_CORP_CODE=00000000    # 8자리 DART 고유번호 (예: KG이니시스 00264547)
DART_CORP_NM=회사명
